from AlgorithmImports import *
import numpy as np
from datetime import timedelta, datetime


class MultiFactorAdaptiveAlgorithm(QCAlgorithm):

    def Initialize(self):
        # ===== Configuración básica =====
        self.SetStartDate(2010, 1, 1)
        self.SetEndDate(2024, 1, 1)
        self.SetCash(100000)

        self.UniverseSettings.Resolution = Resolution.DAILY

        # Universo / factores
        self.num_coarse = 800
        self.num_long = 30
        self.num_short = 30

        # Coarse + Fine
        self.AddUniverse(self.CoarseSelectionFunction, self.FineSelectionFunction)

        # SPY sólo para control de drawdown global
        spy = self.AddEquity("SPY", Resolution.DAILY)
        self.spy = spy.Symbol

        # Estado universe / rebalance
        self.long_symbols = []
        self.short_symbols = []
        self.current_universe = []

        self.last_coarse_month = -1
        self.universe_last_changed = datetime.min
        self.last_rebalance_date = datetime.min

        # Rebalanceo cada 2 meses
        self.rebalance_interval_months = 2

        # ===== Overlay de riesgo (sólo por drawdown) =====
        self.target_exposure = 1.0        # factor global
        self.dd_soft = -0.12             # DD < -12% → bajar riesgo
        self.dd_hard = -0.18             # DD < -18% → bajar más

        # Control DD
        self.peak_equity = 0.0
        self.max_portfolio_drawdown = 0.0

        # Umbral mínimo de cambio de peso (1%)
        self.min_weight_change = 0.01

        # Warmup
        self.SetWarmup(400, Resolution.DAILY)

        # Schedulers
        self.Schedule.On(
            self.DateRules.EveryDay(self.spy),
            self.TimeRules.AfterMarketOpen(self.spy, 10),
            self.DailyRiskCheck
        )

        self.Schedule.On(
            self.DateRules.MonthStart(self.spy),
            self.TimeRules.AfterMarketOpen(self.spy, 20),
            self.MonthlyRebalance
        )

    # ===========================
    #   UNIVERSE: COARSE + FINE
    # ===========================

    def CoarseSelectionFunction(self, coarse):
        """
        Coarse: filtramos por liquidez y precio, 1 vez al mes.
        """
        if self.Time.month == self.last_coarse_month:
            return Universe.Unchanged

        self.last_coarse_month = self.Time.month

        filtered = [c for c in coarse if c.HasFundamentalData and c.Price > 5]
        sorted_by_dv = sorted(filtered, key=lambda x: x.DollarVolume, reverse=True)
        return [c.Symbol for c in sorted_by_dv[:self.num_coarse]]

    def FineSelectionFunction(self, fine):
        """
        Fine: modelo multifactor (value + quality + momentum multi-horizonte).
        Se recalcula cuando el coarse ha cambiado (mensual).
        """
        if self.IsWarmingUp:
            return self.current_universe

        # Filtro fundamental
        filtered = [
            f for f in fine
            if f.HasFundamentalData
            and f.SecurityReference.IPODate is not None
            and f.SecurityReference.IPODate < self.Time - timedelta(days=365 * 5)
            and f.ValuationRatios is not None
            and f.OperationRatios is not None
            and f.ValuationRatios.PERatio is not None
            and f.ValuationRatios.PERatio > 0
            and f.OperationRatios.OperationMargin is not None
            and f.ValuationRatios.PriceChange1M is not None
        ]

        if len(filtered) < self.num_long + self.num_short:
            self.Debug(f"[Fine] Filtro dejó {len(filtered)} acciones, uso universo previo")
            return self.current_universe

        # ----- Funciones de factor -----
        def value_score(f):
            return f.ValuationRatios.PERatio  # más bajo mejor

        def quality_score(f):
            return f.OperationRatios.OperationMargin.Value  # más alto mejor

        def momentum_score(f):
            vr = f.ValuationRatios
            m1 = vr.PriceChange1M or 0
            m6 = getattr(vr, "PriceChange6M", None) or m1
            m12 = getattr(vr, "PriceChange1Y", None) or m6
            # momentum 1/6/12 meses
            return 0.2 * m1 + 0.3 * m6 + 0.5 * m12

        # Ordenamos por cada factor
        sorted_value = sorted(filtered, key=value_score)
        sorted_quality = sorted(filtered, key=quality_score, reverse=True)
        sorted_mom = sorted(filtered, key=momentum_score, reverse=True)

        # Rank-sum ponderado
        scores = {}
        for f in filtered:
            try:
                rv = sorted_value.index(f)
                rq = sorted_quality.index(f)
                rm = sorted_mom.index(f)
            except ValueError:
                continue
            scores[f] = 0.4 * rv + 0.3 * rq + 0.3 * rm

        if not scores:
            return self.current_universe

        ranked = sorted(scores.items(), key=lambda kv: kv[1])
        ordered = [kv[0] for kv in ranked]

        self.long_symbols = [f.Symbol for f in ordered[:self.num_long]]
        self.short_symbols = [f.Symbol for f in ordered[-self.num_short:]]
        self.current_universe = list(set(self.long_symbols + self.short_symbols))

        self.universe_last_changed = self.Time

        self.Debug(f"[Fine] {self.Time.date()} → universe={len(self.current_universe)}, "
                   f"longs={len(self.long_symbols)}, shorts={len(self.short_symbols)}")

        return self.current_universe

    def OnSecuritiesChanged(self, changes):
        """
        Cerramos posiciones que salen del universo.
        """
        for removed in changes.RemovedSecurities:
            sym = removed.Symbol
            if self.Portfolio[sym].Invested:
                self.Liquidate(sym)
                self.Debug(f"Liquidate {sym} (removed from universe)")

    # ===========================
    #   REBALANCE BIMESTRAL
    # ===========================

    def MonthlyRebalance(self):
        if self.IsWarmingUp:
            return

        # Esperar al menos 1 día tras cambio de universe
        if (self.Time - self.universe_last_changed).days < 1:
            self.Debug("[Rebalance] Espero 1 día para precios de nuevos símbolos")
            return

        # No rebalancear hasta que hayan pasado 'rebalance_interval_months'
        if self.last_rebalance_date != datetime.min:
            months_diff = (self.Time.year - self.last_rebalance_date.year) * 12 + \
                          (self.Time.month - self.last_rebalance_date.month)
            if months_diff < self.rebalance_interval_months:
                return

        if not self.long_symbols or not self.short_symbols:
            self.Debug("[Rebalance] No hay listas long/short")
            return

        candidates = self.long_symbols + self.short_symbols

        # Vol de 63 días para sizing inverso
        vols = {}
        for symbol in candidates:
            hist = self.History(symbol, 63, Resolution.DAILY)
            if hist.empty or "close" not in hist.columns:
                continue
            closes = hist["close"].values
            if len(closes) < 2:
                continue
            rets = np.diff(closes) / closes[:-1]
            vol = np.std(rets)
            if vol > 0:
                vols[symbol] = vol

        long_syms = [s for s in self.long_symbols if s in vols]
        short_syms = [s for s in self.short_symbols if s in vols]

        if not long_syms or not short_syms:
            self.Debug("[Rebalance] Vols insuficientes")
            return

        inv_long = {s: 1.0 / vols[s] for s in long_syms}
        inv_short = {s: 1.0 / vols[s] for s in short_syms}
        sum_long = sum(inv_long.values())
        sum_short = sum(inv_short.values())

        # ==== Sesgo neto largo más agresivo ====
        # 110% long / 30% short (neto ~80%), escalado por target_exposure
        gross_long = 1.1 * self.target_exposure
        gross_short = 0.3 * self.target_exposure

        targets = {}
        for s in long_syms:
            targets[s] = gross_long * inv_long[s] / sum_long
        for s in short_syms:
            targets[s] = -gross_short * inv_short[s] / sum_short

        # Liquidar lo que ya no es objetivo
        for kvp in self.Portfolio:
            sym = kvp.Key
            holding = kvp.Value
            if holding.Invested and sym not in targets:
                self.Liquidate(sym)

        equity = max(self.Portfolio.TotalPortfolioValue, 1)

        # Aplicar nuevos pesos (HasData + cambio mínimo)
        for sym, target_w in targets.items():
            if not self.Securities.ContainsKey(sym) or not self.Securities[sym].HasData:
                continue

            current_val = self.Portfolio[sym].HoldingsValue
            current_w = current_val / equity
            if abs(target_w - current_w) < self.min_weight_change:
                continue

            self.SetHoldings(sym, target_w)

        self.last_rebalance_date = self.Time

        self.Debug(f"[Rebalance] {self.Time.date()} exp={self.target_exposure:.2f}, "
                   f"longs={len(long_syms)}, shorts={len(short_syms)}")

    # ===========================
    #   OVERLAY DE RIESGO (DD)
    # ===========================

    def DailyRiskCheck(self):
        if self.IsWarmingUp:
            return

        equity = self.Portfolio.TotalPortfolioValue

        if self.peak_equity == 0:
            self.peak_equity = equity
        else:
            self.peak_equity = max(self.peak_equity, equity)

        dd = (equity - self.peak_equity) / self.peak_equity
        self.max_portfolio_drawdown = min(self.max_portfolio_drawdown, dd)

        new_exposure = 1.0
        if dd < self.dd_soft:
            new_exposure = 0.7
        if dd < self.dd_hard:
            new_exposure = 0.4

        if abs(new_exposure - self.target_exposure) <= 0.05:
            return

        self.Debug(f"[Risk] {self.Time.date()} exp {self.target_exposure:.2f} -> "
                   f"{new_exposure:.2f} (DD={dd:.2%})")

        factor = 0 if self.target_exposure == 0 else new_exposure / self.target_exposure
        equity = max(self.Portfolio.TotalPortfolioValue, 1)

        for kvp in self.Portfolio:
            sym = kvp.Key
            holding = kvp.Value
            if not holding.Invested:
                continue
            if not self.Securities.ContainsKey(sym) or not self.Securities[sym].HasData:
                continue

            current_w = holding.HoldingsValue / equity
            target_w = current_w * factor
            if abs(target_w - current_w) < self.min_weight_change:
                continue

            self.SetHoldings(sym, target_w)

        self.target_exposure = new_exposure
